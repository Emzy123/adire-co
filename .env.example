# ==============================================================================
# Adire & Co. - Environment Variables Configuration
# ==============================================================================
# In Vercel: Set these under Project Settings -> Environment Variables.
# To switch between Test and Live mode, simply replace pk_test / sk_test with pk_live / sk_live.
#
# SECURITY: Never commit actual secret keys or values to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PAYSTACK PAYMENT INTEGRATION
# ------------------------------------------------------------------------------
# Secret Key (Server-side ONLY: used in /api/initialize, /api/verify, and /api/paystack-webhook)
# Set in Vercel Serverless environment variables. Never exposed to browser or client bundle.
PAYSTACK_SECRET_KEY=

# Public Key (Optional client reference / fallback)
PAYSTACK_PUBLIC_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ORDER PERSISTENCE (Vercel KV or Upstash Redis)
# ------------------------------------------------------------------------------
# Used to store pending and paid orders securely on the server.
# If using Vercel KV Marketplace or Upstash Redis REST API:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Or standard Vercel KV aliases:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ------------------------------------------------------------------------------
# 3. STORE OWNER ORDER NOTIFICATIONS (Resend Email)
# ------------------------------------------------------------------------------
# Used by /api/paystack-webhook to notify the shop owner upon successful payment
RESEND_API_KEY=

# Store owner recipient email for new order alerts (defaults to orders@adireandco.com if empty)
ORDER_NOTIFICATION_EMAIL=

# Sender address configured in Resend (e.g. Adire & Co Orders <onboarding@resend.dev> or custom domain)
RESEND_FROM_EMAIL=
